
# Telegram credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

#internal gateway key, e.g openssl rand -hex 32
GATEWAY_API_KEY=

# OCI CLI CONFIGURATION KEYS
# Oracle cloud: User settings -> details
OCI_CLI_USER=
# Oracle cloud: Tenancy -> Region Management
OCI_CLI_REGION=
# Oracle cloud: User settings -> Tokens and keys
OCI_CLI_FINGERPRINT=
# Local path to the oci api private key
OCI_CLI_KEY_FILE=/workspace/OCI/.oci/keys/api/oci_api_key.pem
# Oracle cloud: Tenancy -> Tenancy details
OCI_CLI_TENANCY=

# OCI SCRIPT KEYS
# e.g gppH:EU-FRANKFURT-1-AD-1,gppH:EU-FRANKFURT-1-AD-2,gppH:EU-FRANKFURT-1-AD-3
SOCI_AVAILABILITY_DOMAINS=
SOCI_CONN_TIMEOUT_S=30
SOCI_MAX_LOG_SIZE=2048
# - local paths
SOCI_LOG_FILE=/workspace/OCI/logs/oci.log
SOCI_ERR_LOG_FILE=/workspace/OCI/logs/error.log
SOCI_INSTANCE_PUBLIC_KEY=/workspace/OCI/.oci/keys/script/id_rsa.pub
# Oracle cloud: Identity & Security -> Copartments
SOCI_COPARTMENT=
# oracle cloud: Networking -> Virtual Cloud Networks -> Subnets
SOCI_SUBNET=
# oracle cloud cli: oci compute image list --compartment-id <SOCI_COPARTMENT>
SOCI_IMAGE=

#INSTANCE SPECIFIC OCI SCRIPT KEYS
SOCI_INSTANCE_NAME=testvm
SOCI_INSTANCE_SHAPE=VM.Standard.A1.Flex
SOCI_OCPUS=1
SOCI_RAM_GB=1
SOCI_BOOT_VOLUME_GB=50
SOCI_PUBLIC_IP=true
SOCI_PRIVATE_DNS=true

